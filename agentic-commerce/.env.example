# Razorpay TEST-MODE credentials only. Never commit the real .env file.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Path to the SQLite DB file used by the merchant service
DATABASE_PATH=db/merchant.db

# Base URL the buyer agent CLI calls
MERCHANT_API_BASE_URL=http://127.0.0.1:8000

# OPTIONAL: enables real Claude-based natural-language goal parsing for
# buyer_agent/agent.py's --goal flag. If unset, --goal falls back to a
# local word-overlap heuristic with zero external dependencies -- the CLI
# is fully functional either way. This key is NEVER used on the money
# path (see README "AI Judgment" section) -- it only affects which
# product a --goal request resolves to.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
